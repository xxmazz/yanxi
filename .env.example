# 前端交互原型无需配置密钥；后端服务使用独立环境配置。
# 任何服务密钥都不得写入 VITE_* 变量或前端代码。
YANXI_LLM_PATH=/absolute/path/to/Qwen2.5-7B-Instruct
YANXI_LLM_SHARD=1
YANXI_EMBEDDING_PATH=/absolute/path/to/multilingual-e5-small
YANXI_EMBEDDING_DEVICE=cuda:2
YANXI_DATA_DIR=runtime/library
YANXI_DIST_DIR=dist
# 扫描件 OCR 可选；先预下载权重后启用，在线服务不会联网下载。
YANXI_OCR_PATH=/absolute/path/to/easyocr
YANXI_OCR_DEVICE=cuda:3
